# Local Supabase (`npm run db:start` prints these). Use your project's values in production.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Simulation is on by default so a fresh checkout never sends real email.
# Set SIMULATE_SENDS=false and the Google OAuth client below to send for real.
SIMULATE_SENDS=true
SIMULATED_SEND_DELAY_MS=150
SIMULATED_RATE_LIMIT_RATE=0.05
SIMULATED_SERVER_ERROR_RATE=0.02

# Google OAuth client used to refresh sender access tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where unsubscribe links point. {token} is replaced; otherwise the token is appended as a path segment.
UNSUBSCRIBE_URL_BASE=http://localhost:3000/api/unsubscribe?token={token}

# Required by the cron route. Vercel sends it as a bearer token on scheduled calls.
CRON_SECRET=

# Worker timing (defaults shown). The warmup policy in Postgres can make sender pacing stricter.
WORKER_DRAIN_BUDGET_MS=270000
WORKER_SHUTDOWN_MARGIN_MS=30000
WORKER_RECIPIENT_LEASE_SECONDS=300
WORKER_SENDER_MIN_INTERVAL_SECONDS=180
WORKER_TOKEN_CANDIDATE_LIMIT=50
WORKER_PROVIDER_SEND_TIMEOUT_MS=30000
WORKER_PROVIDER_REFRESH_TIMEOUT_MS=15000
WORKER_DEFAULT_RETRY_DELAY_SECONDS=300

# Local runner only: how many cycles `npm run dev` / `npm start` runs, and the pause between them.
WORKER_LOOP_CYCLES=1
WORKER_LOOP_DELAY_MS=0
